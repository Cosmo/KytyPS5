<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         IgnorableNamespaces="uap">
  <Identity Name="@KYTY_UWP_PACKAGE_NAME@" Publisher="CN=KytyPS5" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>@KYTY_UWP_DISPLAY_NAME@</DisplayName>
    <PublisherDisplayName>KytyPS5</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
    <PackageDependency Name="Microsoft.VCLibs.140.00" MinVersion="14.0.30035.0"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
    <PackageDependency Name="Microsoft.UI.Xaml.2.8" MinVersion="@kyty_uwp_winui_version@"
                       Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="kyty_uwp.exe" EntryPoint="KytyPS5.App">
      <uap:VisualElements DisplayName="@KYTY_UWP_DISPLAY_NAME@" Description="PlayStation 5 emulator"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0b0e14" />
      </uap:VisualElements>
      <Extensions>
        <!-- <protocol>://run?game=<path> starts a game directly (used by uwp.ps1 run). -->
        <uap:Extension Category="windows.protocol">
          <uap:Protocol Name="@KYTY_UWP_PROTOCOL@" />
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="codeGeneration" />
    <!-- USB drives: on the Xbox, games are on one (README.md). -->
    <uap:Capability Name="removableStorage" />
    <!-- Game folders are read directly: they grant UWP apps read access (README.md). -->
  </Capabilities>
</Package>
