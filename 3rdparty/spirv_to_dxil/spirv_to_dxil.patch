+
+/* Order of a stage in a graphics pipeline, or -1 if it can't be part of one. A mesh
+ * shader replaces the vertex processing stages, so it can only come first. */
+static int
+graphics_stage_order(dxil_spirv_shader_stage stage, unsigned index)
+{
+   if (stage == DXIL_SPIRV_SHADER_MESH)
+      return index == 0 ? DXIL_SPIRV_SHADER_GEOMETRY : -1;
+   if (stage == DXIL_SPIRV_SHADER_NONE || stage > DXIL_SPIRV_SHADER_FRAGMENT)
+      return -1;
+   return stage;
+}
+
+bool
+spirv_to_dxil_linked(const struct dxil_spirv_stage *stages, unsigned int stage_count,
+                     enum dxil_validator_version validator_version_max,
+                     const struct dxil_spirv_debug_options *dgb_opts,
+                     const struct dxil_spirv_logger *logger,
+                     struct dxil_spirv_object *out_dxil)
+{
+   if (stage_count == 0 || stage_count > MESA_SHADER_FRAGMENT + 1)
+      return false;
+   for (unsigned i = 0; i < stage_count; i++) {
+      const int order = graphics_stage_order(stages[i].stage, i);
+      if (order < 0 ||
+          (i > 0 && order <= graphics_stage_order(stages[i - 1].stage, i - 1)))
+         return false;
+      memset(&out_dxil[i], 0, sizeof(out_dxil[i]));
+   }
+
+   glsl_type_singleton_init_or_ref();
+
+   /* spirv_to_nir keeps a pointer to its options, so they live until emission. */
+   nir_shader_compiler_options nir_options[MESA_SHADER_FRAGMENT + 1];
+   nir_shader *nir[MESA_SHADER_FRAGMENT + 1] = {0};
+   bool success = true;
+   for (unsigned i = 0; success && i < stage_count; i++) {
+      nir[i] = spirv_stage_to_nir(&stages[i], &nir_options[i], dgb_opts, &out_dxil[i].metadata);
+      success = nir[i] != NULL;
+   }
+
+   /* Link each stage to the one before it, from the last stage backwards, so the
+    * signatures of consecutive stages match. */
+   for (unsigned i = stage_count - 1; success && i > 0; i--) {
+      struct dxil_spirv_metadata metadata = {0};
+      dxil_spirv_nir_link(nir[i], nir[i - 1], stages[i].conf, &metadata);
+      out_dxil[i].metadata.requires_runtime_data |= metadata.requires_runtime_data;
+   }
+
+   for (unsigned i = 0; success && i < stage_count; i++)
+      success = nir_stage_to_dxil(nir[i], stages[i].conf, validator_version_max, logger, &out_dxil[i]);
+
+   for (unsigned i = 0; i < stage_count; i++) {
+      ralloc_free(nir[i]);
+      if (!success)
+         spirv_to_dxil_free(&out_dxil[i]);
+   }
+
+   glsl_type_singleton_decref();
+   return success;
 }
 
